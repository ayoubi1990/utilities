{
  "manifest_version": 3,
  "name": "velo integration",
  "version": "0.1.0",
  "description": "Adds a download button to videos and a \"Download with velo\" menu item, and sends them to the velo download manager.",
  "permissions": ["webRequest", "contextMenus", "cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
